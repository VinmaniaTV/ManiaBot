  "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "esModuleInterop": true,
      "skipDefaultLibCheck": true,
      "skipLibCheck": true,
      "outDir": "dist",
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "strict": true,
      "allowJs": true
  }
}